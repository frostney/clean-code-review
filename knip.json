{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/app/globals.css",
    "agent/agent.ts",
    "agent/instructions.ts",
    "agent/channels/*.ts",
    "agent/schedules/*.ts",
    "agent/**/*.test.ts",
    "scripts/*.ts",
    "agent/**/*.test.ts",
    "src/**/*.test.ts"
  ],
  "ignoreDependencies": ["server-only", "vercel"],
  "project": ["**/*.{ts,tsx,mjs,css}"]
}
