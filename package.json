{
  "name": "clean-code-review",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "judge": "bun scripts/judge-once.ts",
    "review": "bun scripts/summary-once.ts",
    "jev": "bun --env-file=.env.local scripts/jev-once.ts",
    "deploy": "eve deploy",
    "eval": "eve eval",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/connect": "1.0.0",
    "@vercel/functions": "^3.9.8",
    "ai": "^7.0.93",
    "eve": "^0.57.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwindcss": "4.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.17",
    "@types/node": "24.x",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vercel": "^59.20.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.4.0"
}
